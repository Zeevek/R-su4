{
  "id": "/budget-personnel/",
  "name": "Budget Personnel",
  "short_name": "Budget",
  "description": "Budget mensuel, épargne et portefeuille — entièrement hors ligne, aucune donnée ne quitte l'appareil.",
  "lang": "fr-FR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "background_color": "#0F1117",
  "theme_color": "#0F1117",
  "categories": [
    "finance",
    "productivity",
    "utilities"
  ],
  "orientation": "any",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-256.png",
      "sizes": "256x256",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "capture-large.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Vue d'ensemble sur ordinateur"
    },
    {
      "src": "capture-mobile.png",
      "sizes": "540x1000",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vue d'ensemble sur téléphone"
    }
  ],
  "shortcuts": [
    {
      "name": "Saisir une dépense",
      "short_name": "Dépense",
      "description": "Ouvre directement la saisie rapide",
      "url": "./index.html?saisie=1",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Voir le mois en cours",
      "short_name": "Mois",
      "description": "Ouvre la page du mois",
      "url": "./index.html?page=mois",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Portefeuille",
